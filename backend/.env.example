# ─── Database ───────────────────────────────────────────
# Local SQLite (default — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./stockmind.db
# Railway PostgreSQL (auto-set by Railway plugin — leave blank locally)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── AI / LLM ───────────────────────────────────────────
# Required for AI chat, scenario analysis, sentiment, daily summary
# Get free key at: https://console.groq.com
GROQ_API_KEY=

# ─── News ───────────────────────────────────────────────
# Required for news feed and sentiment analysis
# Get free key at: https://newsapi.org (100 req/day free tier)
NEWS_API_KEY=

# ─── Telegram Notifications ─────────────────────────────
# Optional — for daily briefing and risk alerts via Telegram
# 1. Message @BotFather → /newbot → copy token
# 2. Start chat with your bot
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates → copy chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── CORS ───────────────────────────────────────────────
# Set to your Vercel URL after frontend deploy
# Example: https://stockmind.vercel.app
FRONTEND_URL=

# ─── Environment ────────────────────────────────────────
ENVIRONMENT=development
